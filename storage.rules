rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Usta resimleri - doğrulanmış kullanıcılar yükleyebilir
    match /ustalar/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Genel dosyalar - herkes okuyabilir, sadece admin yükleyebilir
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.auth.token.email in ['admin@ankaraustabul.com'];
    }
  }
}
