rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ustalar koleksiyonu - herkes okuyabilir, sadece doğrulanmış kullanıcılar yazabilir
    match /ustalar/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email_verified == true;
    }
    
    // Kullanıcılar koleksiyonu - sadece kendi verilerine erişebilir
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Ödemeler koleksiyonu - sadece admin erişebilir
    match /payments/{document} {
      allow read, write: if request.auth != null && 
        request.auth.token.email in ['admin@ankaraustabul.com'];
    }
    
    // Admin koleksiyonu - sadece admin erişebilir
    match /admin/{document} {
      allow read, write: if request.auth != null && 
        request.auth.token.email in ['admin@ankaraustabul.com'];
    }
  }
}
